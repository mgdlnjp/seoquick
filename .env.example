# ─── Serveur API (Express) ───────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# Active la récupération réelle d'URL. Mettre à false pour ne servir que le mode démo.
ENABLE_LIVE_FETCH=true

# User-agent explicite envoyé aux sites analysés (indiquer une URL de contact réelle).
USER_AGENT="SEOQuickBot/0.1 (+https://example.com/robot; audit SEO on-page a la demande)"

# Limites réseau
FETCH_TIMEOUT_MS=10000        # durée maximale totale d'une analyse (redirections comprises)
CONNECT_TIMEOUT_MS=4000       # inactivité socket max (connexion / lecture)
MAX_RESPONSE_BYTES=3000000    # taille max du HTML décompressé (octets)
MAX_REDIRECTS=5
ALLOWED_PORTS=80,443          # ports de destination autorisés

# Limitation de fréquence (par adresse IP du visiteur, en mémoire)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_FETCHES=8

# Derrière un reverse proxy (Render, Fly, Nginx…), indiquer le nombre de proxys de confiance (ex: 1).
TRUST_PROXY=false

# Sert le front compilé (dist/) depuis le même processus.
SERVE_STATIC=true

# ─── Front (variables lues au build par Vite) ────────────────────────
# URL publique du site, utilisée pour canonical / Open Graph / sitemap.
VITE_SITE_URL=https://example.com
# true = build statique sans API : seul le mode démo est disponible.
VITE_DEMO_ONLY=false

# --- Abonnement Stripe (facultatif) ---
# Sans STRIPE_SECRET_KEY et STRIPE_PRICE_ID, la facturation est désactivée et les analyses restent en accès libre.
STRIPE_SECRET_KEY=
# Prix récurrent du forfait Pro (dashboard.stripe.com → Catalogue de produits).
STRIPE_PRICE_ID=
# Secret de signature des jetons d'accès Pro, au moins 32 caractères : openssl rand -base64 48
ACCESS_TOKEN_SECRET=
# Origine publique de l'app pour les redirections Stripe (recommandé en production), sans / final.
APP_URL=
# Analyses d'URL gratuites par IP sur 24 h glissantes (le mode démo reste illimité).
FREE_USES_PER_DAY=3
