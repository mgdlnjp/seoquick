{
  "name": "seoquick",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && npm run prerender && npm run build:server",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "description": "SEOQuick — audit SEO on-page d’une page web à partir de son HTML initial",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.70.0",
    "parse5": "^8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  }
}
